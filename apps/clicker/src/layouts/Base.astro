---
import '@fontsource-variable/manrope';
import '@fontsource/space-grotesk/700.css';
import '../styles/site.css';
import bodyFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { COPY, GAME, SITE_URL } from '../content.mjs';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = COPY.title, description = COPY.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), SITE_URL).href;
const ogImage = `${SITE_URL}/og.jpg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08080a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={GAME.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={COPY.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={COPY.ogImageAlt} />
    <meta name="author" content="Mason Bair" />
    <link rel="author" href="https://masonbair.com" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Plain-text summary for AI tools" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
